# Rendered by golden-k8 (role: render). Do not edit build/ output.
# Shared entry point: one Gateway, apps attach HTTPRoutes.
---
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: EnvoyProxy
metadata:
  name: golden-proxy
  namespace: envoy-gateway-system
spec:
  provider:
    type: Kubernetes
    kubernetes:
      envoyDeployment:
        replicas: 1
        container:
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              memory: 256Mi
      envoyService:
        type: {{ golden_contract.gateway_service_type }}
{% if golden_contract.lb_annotations %}
        annotations:
{% for key, value in golden_contract.lb_annotations | dictsort %}
          {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if golden_contract.gateway_service_type == 'NodePort' %}
        patch:
          type: StrategicMerge
          value:
            spec:
              ports:
                - port: 80
                  nodePort: {{ golden_contract.gateway_node_port }}
{% endif %}
---
apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: golden
spec:
  controllerName: gateway.envoyproxy.io/gatewayclass-controller
  parametersRef:
    group: gateway.envoyproxy.io
    kind: EnvoyProxy
    name: golden-proxy
    namespace: envoy-gateway-system
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: golden-gateway
  namespace: envoy-gateway-system
spec:
  gatewayClassName: golden
  listeners:
    - name: http
      protocol: HTTP
      port: 80
      allowedRoutes:
        namespaces:
          from: Selector
          selector:
            matchLabels:
              golden-k8/gateway-access: "true"
